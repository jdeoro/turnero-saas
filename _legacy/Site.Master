<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SeguimientoGestion.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Seguimiento y Gestión</title>
    
    <%-- Fuentes --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <%-- Estilos globales --%>
    <link rel="stylesheet" href="<%= ResolveUrl("~/css/styles.css") %>" />

    <%-- Tema institucional dinámico --%>
    <style type="text/css" id="css-institutional-theme">
        :root {
            --color-primary: <%= ColorInstitucional %> !important;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app-body">
    <form id="formMaster" runat="server">
        <div class="app-layout" id="appLayout">
            
            <%-- SIDEBAR IZQUIERDA --%>
            <aside class="app-sidebar" id="appSidebar">
                
                <%-- Cabecera del Sidebar con Logo y Botón de Colapso --%>
                <div class="sidebar-header">
                    <div class="sidebar-brand">
                        <img src="<%= ResolveUrl(LogoApp) %>" alt="Logo" class="sidebar-logo"
                             onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />
                        <div id="fallbackIcon" class="sidebar-logo-fallback" style="display:none;">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4.18c1.76 0 3.18 1.42 3.18 3.18S13.76 11.54 12 11.54 8.82 10.12 8.82 8.36 10.24 5.18 12 5.18z"/>
                            </svg>
                        </div>
                        <span class="sidebar-brand-name"><%= TituloApp %></span>
                    </div>
                    <button type="button" class="sidebar-toggle-btn" id="btnToggleSidebar" title="Colapsar / Expandir menú">
                        <svg class="toggle-icon-collapse" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                        </svg>
                        <svg class="toggle-icon-expand" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none;">
                            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                        </svg>
                    </button>
                </div>

                <%-- Navegación principal --%>
                <nav class="sidebar-nav">
                    <ul class="sidebar-menu">
                        <li class="menu-item <%= IsActive("Default.aspx") %>">
                            <a href="<%= ResolveUrl("~/Default.aspx") %>" class="menu-link" title="Inicio" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Inicio</span>
                            </a>
                        </li>

                        <li class="menu-item <%= IsActive("Operador.aspx") %>">
                            <a href="<%= ResolveUrl("~/Operador.aspx") %>" class="menu-link" title="Panel Operador" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Panel Operador</span>
                            </a>
                        </li>

                        <li class="menu-item <%= IsActive("Totem.aspx") %>">
                            <a href="<%= ResolveUrl("~/Totem.aspx") %>" class="menu-link" title="Tótem Autoservicio" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M4 6h16v10H4V6zm2 2v6h12V8H6zm-4 9h20v2H2v-2z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Tótem Kiosco</span>
                            </a>
                        </li>

                        <li class="menu-item <%= IsActive("Carteleria.aspx") %>">
                            <a href="<%= ResolveUrl("~/Carteleria.aspx") %>" class="menu-link" title="Pantalla TV Sala de Espera" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Pantalla TV</span>
                            </a>
                        </li>

                        <% if (EsSupervisor) { %>
                        <%-- Opcion temporalmente pausada hasta desarrollo de pantalla
                        <li class="menu-item <%= IsActive("Supervision.aspx") %>">
                            <a href="<%= ResolveUrl("~/Supervision.aspx") %>" class="menu-link" title="Supervisión" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Supervisión</span>
                            </a>
                        </li>
                        --%>

                        <li class="menu-item <%= IsActive("Configuracion.aspx") %>">
                            <a href="<%= ResolveUrl("~/Configuracion.aspx") %>" class="menu-link" title="Configuración" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Configuración</span>
                            </a>
                        </li>

                        <li class="menu-item <%= IsActive("Reportes.aspx") %>">
                            <a href="<%= ResolveUrl("~/Reportes/Metricas.aspx") %>" class="menu-link" title="Reportes" target="_blank">
                                <span class="menu-icon">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                                    </svg>
                                </span>
                                <span class="menu-label">Reportes</span>
                            </a>
                        </li>
                        <% } %>
                    </ul>
                </nav>

                <%-- Perfil del usuario en la base del Sidebar --%>
                <div class="sidebar-footer">
                    <div class="user-profile-badge">
                        <div class="user-avatar-initials"><%= Initials %></div>
                        <div class="user-profile-info">
                            <span class="user-profile-name"><%= CurrentUserName %></span>
                            <span class="user-profile-role"><%= CurrentUserRole %></span>
                        </div>
                    </div>
                </div>

            </aside>

            <%-- CONTENIDO PRINCIPAL --%>
            <div class="app-main-wrapper">
                
                <%-- Topbar superior --%>
                <header class="app-topbar">
                    <div class="topbar-left">
                        <h2 class="topbar-title"><%: Page.Title %></h2>
                    </div>
                    <div class="topbar-right">
                        <span class="topbar-date"><%= DateTime.Now.ToString("dd/MM/yyyy") %></span>
                        <span class="badge-role-pill"><%= CurrentUserRole %></span>
                        <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn-topbar-logout" OnClick="lnkLogout_Click" ToolTip="Cerrar Sesión">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                            </svg>
                            <span>Salir</span>
                        </asp:LinkButton>
                    </div>
                </header>

                <main class="app-main-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

            </div>
        </div>
    </form>

    <%-- Script del Sidebar --%>
    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var layout = document.getElementById('appLayout');
            var btnToggle = document.getElementById('btnToggleSidebar');
            var iconCollapse = btnToggle.querySelector('.toggle-icon-collapse');
            var iconExpand = btnToggle.querySelector('.toggle-icon-expand');

            // Leer estado guardado
            var isCollapsed = localStorage.getItem('sg_sidebar_collapsed') === '1';
            if (isCollapsed) {
                sidebar.classList.add('collapsed');
                layout.classList.add('sidebar-collapsed');
                iconCollapse.style.display = 'none';
                iconExpand.style.display = 'block';
            }

            btnToggle.addEventListener('click', function () {
                var collapsed = sidebar.classList.toggle('collapsed');
                layout.classList.toggle('sidebar-collapsed', collapsed);
                iconCollapse.style.display = collapsed ? 'none' : 'block';
                iconExpand.style.display = collapsed ? 'block' : 'none';
                localStorage.setItem('sg_sidebar_collapsed', collapsed ? '1' : '0');
            });
        })();
    </script>
</body>
</html>